# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Frontend origin(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173

# ---------- Database (MongoDB Atlas or local) ----------
MONGODB_URI=mongodb://127.0.0.1:27017/invertis_studysphere

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# lax for same-origin (recommended, use proxy/rewrites). Use "none" only if frontend and API are on different sites (needs HTTPS).
COOKIE_SAMESITE=lax

# ---------- File storage ----------
# Leave Cloudinary values empty to store files on local disk (UPLOAD_DIR). Fine for development;
# on Render/Vercel free tiers local disk is wiped on redeploy, so use Cloudinary in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=./uploads
MAX_FILE_MB=50

# ---------- Email (optional) ----------
# If SMTP_HOST is empty, emails are printed to the server console and email verification is skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Invertis StudySphere <no-reply@example.com>"

# ---------- First Super Admin (used only by `npm run create-admin`) ----------
SUPERADMIN_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
